# Copia este archivo a .env.local y rellena con los valores de tu proyecto
# Supabase (Project Settings → API). La anon key es pública por diseño
# (protegida por RLS) — la service_role key NUNCA debe usarse en el
# frontend ni commitearse.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta (Project Settings -> API Keys -> secret key). Server-only.
SUPABASE_SECRET_KEY=

# Web Push (VAPID). Generar una vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# QStash (Upstash) — entrega recordatorios y avisos de fin de fase en el
# instante exacto, sin sondeo. Panel de Upstash → QStash → tu región →
# "Quickstart".
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Origen público de la app — QStash necesita una URL absoluta a la que llamar.
APP_URL=http://localhost:3000

# Avisos por correo cuando falla algo en la app (ver
# src/core/infrastructure/error-reporting/report-error.ts). Sin las dos
# primeras no se avisa ni se registra nada — así ni `next dev` ni las
# previews te llenan el correo. Resend → API Keys; con permiso solo de envío
# basta.
RESEND_API_KEY=
# A quién le llegan los avisos (varios, separados por comas).
ERROR_ALERT_EMAIL=
# Remitente. Sin dominio verificado en Resend solo vale su remitente de
# pruebas, que además solo puede escribir al correo de la cuenta de Resend.
ERROR_ALERT_FROM=Fermança <onboarding@resend.dev>
